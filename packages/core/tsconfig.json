{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "module": "esnext",
    "target": "es2020",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
